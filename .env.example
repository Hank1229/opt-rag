# Copy to .env and fill in. .env is gitignored.

# Google AI Studio API key, for embeddings and generation
GEMINI_API_KEY=

# TypeSafe Jev API key (not used yet; reserved for the refusal-gating experiment)
JEV_API_KEY=

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Public key. Only used in tests to verify RLS blocks it; the frontend never talks to Supabase directly.
SUPABASE_PUBLISHABLE_KEY=

# Backend-only key that bypasses RLS. Never commit the value or expose it to the frontend.
SUPABASE_SECRET_KEY=

# Postgres connection string for `scripts/ingest.py --target opt-rag` (Supabase
# dashboard > Connect > Session pooler). Local ingest reads `supabase status` instead.
# The API server never reads DATABASE_URL from this file: set it in the process
# environment (locally, DB_URL from `supabase status -o env`).
DATABASE_URL=

# Generation model for /query. Pinned: the server rejects replies served by any other model version.
GEMINI_GENERATION_MODEL=gemini-3.6-flash

# Generation temperature; the baseline uses 0.
GEMINI_TEMPERATURE=0

# Chunks retrieved per question; the baseline uses 5.
RETRIEVAL_TOP_K=5
