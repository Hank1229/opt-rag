# Copy to .env and fill in. .env is gitignored.

# Google AI Studio API key, for embeddings and generation
GEMINI_API_KEY=

# TypeSafe Jev API key (not used yet; reserved for the refusal-gating experiment)
JEV_API_KEY=

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Public key. Only used in tests to verify RLS blocks it; the frontend never talks to Supabase directly.
SUPABASE_PUBLISHABLE_KEY=

# Backend-only key that bypasses RLS. Never commit the value or expose it to the frontend.
SUPABASE_SECRET_KEY=
